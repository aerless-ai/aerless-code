#!/bin/sh
# Aerless installer: curl -fsSL https://github.com/havecreator/aerless-code/releases/latest/download/install.sh | sh [-s -- flags]
# Puts aerless and aerless-code in ~/.aerless/bin, adds that folder to PATH in your shell's startup file
# (skip with --no-modify-path), then runs aerless with the other flags. No sudo.
# AERLESS_VERSION picks a release (default: latest).
set -eu

fail() { echo "Aerless install failed: $1" >&2; exit 1; }

# Downloads come from GitHub Releases; AERLESS_BASE_URL points at another folder layout (<base>/<version>/<file>).
if [ -n "${AERLESS_BASE_URL:-}" ]; then BASE="$AERLESS_BASE_URL/${AERLESS_VERSION:-latest}"
elif [ -n "${AERLESS_VERSION:-}" ]; then BASE="https://github.com/havecreator/aerless-code/releases/download/v$AERLESS_VERSION"
else BASE="https://github.com/havecreator/aerless-code/releases/latest/download"; fi

case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) fail "unsupported system $(uname -s) (Windows: use install.ps1)" ;;
esac
case "$(uname -m)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=x64 ;;
  *) fail "unsupported CPU $(uname -m)" ;;
esac
# Rosetta: an Apple-silicon Mac running this script as x64 should still get the native build.
[ "$os-$arch" = darwin-x64 ] && [ "$(sysctl -n sysctl.proc_translated 2>/dev/null)" = 1 ] && arch=arm64
name="aerless-$os-$arch"
# Aerless Code has builds for CPUs without AVX2 ("baseline") and for Alpine's musl libc.
code="aerless-code-$os-$arch"
if [ "$arch" = x64 ]; then
  if [ "$os" = linux ]; then grep -qw avx2 /proc/cpuinfo 2>/dev/null || code="$code-baseline"
  else sysctl -n machdep.cpu.leaf7_features 2>/dev/null | grep -qw AVX2 || code="$code-baseline"; fi
fi
[ "$os" = linux ] && { [ -f /etc/alpine-release ] || ldd --version 2>&1 | grep -qi musl; } && code="$code-musl"

modify_path=1
for a do shift; if [ "$a" = --no-modify-path ]; then modify_path=0; else set -- "$@" "$a"; fi; done

if command -v curl >/dev/null 2>&1; then
  get() { curl -fsSL --retry 3 "$1" -o "$2"; }
elif command -v wget >/dev/null 2>&1; then
  get() { wget -q "$1" -O "$2"; }
else
  fail "need curl or wget"
fi
if command -v sha256sum >/dev/null 2>&1; then
  sum() { sha256sum "$1" | cut -d ' ' -f 1; }
elif command -v shasum >/dev/null 2>&1; then
  sum() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
else
  fail "need shasum or sha256sum to check the download"
fi

tmp="$(mktemp -d)" || fail "cannot make a temporary folder"
trap 'rm -rf "$tmp"' EXIT INT TERM

get "$BASE/SHA256SUMS" "$tmp/SHA256SUMS" 2>/dev/null || fail "cannot download $BASE/SHA256SUMS"
get "$BASE/$name" "$tmp/$name" 2>/dev/null || fail "cannot download $BASE/$name"
echo "Downloading Aerless Code (about 200 MB)..."
get "$BASE/$code" "$tmp/$code" || fail "cannot download $BASE/$code"

for f in "$name" "$code"; do
  want="$(awk -v f="$f" '$2 == f || $2 == "*" f { print $1 }' "$tmp/SHA256SUMS")"
  [ -n "$want" ] || fail "$f is not listed in SHA256SUMS"
  [ "$(sum "$tmp/$f")" = "$want" ] || fail "checksum mismatch for $f, nothing was installed"
done

dir="$HOME/.aerless/bin"
mkdir -p "$dir" || fail "cannot create $dir"
chmod +x "$tmp/$name" "$tmp/$code"
mv -f "$tmp/$name" "$dir/aerless" || fail "cannot write $dir/aerless"
mv -f "$tmp/$code" "$dir/aerless-code" || fail "cannot write $dir/aerless-code"

# Alpine's musl build needs the C++ runtime, which a stock Alpine lacks (installing it needs root).
case "$code" in *-musl) [ -e /usr/lib/libstdc++.so.6 ] || echo "Aerless Code needs two system libraries first. Run: apk add libstdc++ libgcc (as root)" ;; esac

# PATH, so `aerless` and `aerless-code` work in new terminals. One line, added once.
case ":$PATH:" in *":$dir:"*) modify_path=0 ;; esac
if [ "$modify_path" = 1 ]; then
  case "$(basename "${SHELL:-sh}")" in
    zsh) rc="${ZDOTDIR:-$HOME}/.zshrc"; line="export PATH=\"$dir:\$PATH\"" ;;
    bash) rc="$HOME/.bashrc"; [ "$os" = darwin ] && rc="$HOME/.bash_profile"; line="export PATH=\"$dir:\$PATH\"" ;;
    fish) rc="$HOME/.config/fish/config.fish"; line="fish_add_path $dir" ;;
    *) rc="$HOME/.profile"; line="export PATH=\"$dir:\$PATH\"" ;;
  esac
  if ! grep -qsF "$dir" "$rc"; then
    mkdir -p "$(dirname "$rc")" && printf '\n# Aerless\n%s\n' "$line" >> "$rc" && echo "Added $dir to PATH in $rc."
  fi
fi

rm -rf "$tmp"
trap - EXIT INT TERM
# With flags (e.g. --version, --show-files) run them as given.
[ $# -gt 0 ] && exec "$dir/aerless" "$@"

# First-time setup asks questions; under `curl | sh` the script itself is stdin, so read the keyboard from the terminal.
echo
if (: </dev/tty) 2>/dev/null; then "$dir/aerless" setup </dev/tty || true; else "$dir/aerless" setup || true; fi
echo
case ":$PATH:" in
  *":$dir:"*) echo "Start Aerless Code: type  aerless" ;;
  *) echo "Start Aerless Code: open a new terminal and type  aerless   (or in this window: exec \$SHELL, then aerless)" ;;
esac
